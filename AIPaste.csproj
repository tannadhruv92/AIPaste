<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Product version — persistent window and startup warmup workflow. -->
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <Product>AIPaste</Product>
    <Company>Dhruv Tanna</Company>
    <Copyright>Copyright © 2026 Dhruv Tanna</Copyright>
    <!-- Exclude satellite assemblies (localization) to keep release smaller -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO1000: WinForms designer serialization warnings on custom controls used only in code. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Allow apphost to roll forward to any installed .NET 9 runtime patch. -->
    <RollForward>LatestMinor</RollForward>
    <!--
      The app uses the SDK's bundled Copilot runtime (a matched pair with this
      SDK version) via the default CopilotClient() — never a system-installed
      CLI — so the client and runtime protocol versions cannot drift apart. To
      pick up newer models, bump the GitHub.Copilot.SDK package and rebuild.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="1.0.0-beta.9" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the app icon as a managed resource so it loads reliably from portable zip installs. -->
    <EmbeddedResource Include="app.ico" LogicalName="AIPaste.app.ico" />
  </ItemGroup>

</Project>