<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Product version. -->
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>AIPaste</Product>
    <Company>Dhruv Tanna</Company>
    <Copyright>Copyright © 2026 Dhruv Tanna</Copyright>
    <!-- Exclude satellite assemblies (localization) to keep release smaller -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO1000: WinForms designer serialization warnings on custom controls used only in code. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Allow apphost to roll forward to any installed .NET 9 runtime patch. -->
    <RollForward>LatestMinor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="1.0.0-beta.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>